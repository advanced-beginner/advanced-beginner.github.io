{
  "analysis": {
    "analyzer": {
      "korean_analyzer": {
        "type": "custom",
        "tokenizer": "nori_tokenizer",
        "filter": [
          "nori_readingform",
          "lowercase",
          "nori_part_of_speech_filter"
        ]
      }
    },
    "tokenizer": {
      "nori_tokenizer": {
        "type": "nori_tokenizer",
        "decompound_mode": "mixed"
      }
    },
    "filter": {
      "nori_part_of_speech_filter": {
        "type": "nori_part_of_speech",
        "stoptags": [
          "E", "IC", "J", "MAG", "MAJ",
          "MM", "SP", "SSC", "SSO", "SC",
          "SE", "XPN", "XSA", "XSN", "XSV",
          "UNA", "NA", "VSV"
        ]
      }
    }
  }
}
